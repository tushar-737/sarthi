# ---------------------------------------------------------------------------
# SAARTHI AI — backend configuration
# Copy to `.env` and edit. Never commit `.env`.
# Every value below is optional: SAARTHI runs fully offline with none of them.
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development
APP_NAME=SAARTHI AI

# --- AI provider -----------------------------------------------------------
# auto   = use OpenAI if OPENAI_API_KEY is set, otherwise Demo Mode (default)
# local  = always Demo Mode, offline and deterministic
# openai = require OpenAI
AI_PROVIDER=auto

# Leave blank to run in Demo Mode. This key stays on the server and is never
# sent to the browser.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=12
AI_TEMPERATURE=0.2

# --- Retrieval tuning ------------------------------------------------------
# Below this confidence SAARTHI asks a clarifying question instead of guessing.
RETRIEVAL_MIN_CONFIDENCE=0.42
RETRIEVAL_TOP_K=5

# --- Database --------------------------------------------------------------
# SQLite by default. For PostgreSQL use e.g.
# postgresql+psycopg://sarthi:secret@localhost:5432/sarthi
# DATABASE_URL=

# --- CORS ------------------------------------------------------------------
# Comma separated. The Vite dev server proxies /api so browsers are usually
# same-origin; add your preview/deploy host here if you call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Safety / privacy ------------------------------------------------------
MAX_QUERY_LENGTH=600
LOG_CONVERSATIONS=true
REDACT_PII_IN_LOGS=true

# --- Voice -----------------------------------------------------------------
MAX_AUDIO_BYTES=12582912

# --- Language --------------------------------------------------------------
DEFAULT_LANGUAGE=hi
